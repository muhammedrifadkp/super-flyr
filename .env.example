# Copy to .env.local for local development, or add these in Vercel → Settings → Environment Variables.
# Every client gets their own deployment with their own values.

# --- Staff login -------------------------------------------------------------
# Shared staff password for /dashboard. Leave empty locally to skip login (demo mode).
ADMIN_PASSWORD=
# Optional: random string used to sign login cookies (defaults to one derived from ADMIN_PASSWORD).
AUTH_SECRET=

# --- Database (MongoDB Atlas) ------------------------------------------------
# Required on Vercel. Locally, leave empty to save data in .data/db.json.
MONGODB_URI=
# Database name. Use one database per client in the same cluster, e.g. demo-superflyr, freshmart-superflyr
MONGODB_DB=

# --- Images (Cloudinary) -----------------------------------------------------
# Required on Vercel. Locally, leave empty to save images in .data/uploads.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Optional. Default: super-flyr/<MONGODB_DB>/<STORE_ID>
CLOUDINARY_FOLDER=

# --- Store id ------------------------------------------------------------------
# Keeps every record tagged with a store, so several stores can share one database later.
STORE_ID=default
